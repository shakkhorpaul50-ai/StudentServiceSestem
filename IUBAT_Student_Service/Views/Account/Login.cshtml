@model IUBAT_Student_Service.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<div class="auth-container">
    <div class="auth-card">
        <div class="auth-header">
            <h3>Sign in to Portal</h3>
            <p class="mb-0 mt-2">Access your requests and services</p>
        </div>
        <div class="auth-body">
            <form asp-action="Login" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="border-radius:8px;font-size:0.9rem;"></div>
                <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" placeholder="you@example.com" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="StudentId" class="form-label">Student ID <span class="text-muted" style="font-weight:400;">(required for students)</span></label>
                    <input asp-for="StudentId" class="form-control" placeholder="Enter your Student ID" />
                    <span asp-validation-for="StudentId" class="text-danger small"></span>
                    <div class="form-text" style="font-size:0.8rem;"><strong>Students:</strong> Student ID is required. <strong>Only staff</strong> can login without Student ID.</div>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" placeholder="Enter password" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="mb-4 form-check">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label" style="font-size:0.9rem;"></label>
                </div>

                <button type="submit" class="btn btn-primary-custom w-100" style="font-size:1rem;">Sign In</button>
            </form>
        </div>
        <div class="auth-footer">
            Don't have an account? <a asp-action="Register">Register here</a>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

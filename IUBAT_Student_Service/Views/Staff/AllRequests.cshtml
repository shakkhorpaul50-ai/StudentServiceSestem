@model IEnumerable<IUBAT_Student_Service.Models.ViewModels.ServiceRequestDetailViewModel>
@{
    ViewData["Title"] = "All Requests";
}

<h2 class="page-title">All Service Requests</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-modern success alert-dismissible fade show" role="alert">
        ✅ @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card mb-4" style="border-radius:12px;box-shadow:0 2px 8px rgba(0,0,0,0.06);border:1px solid #e9ecef;">
    <div class="card-body p-3">
        <form asp-action="AllRequests" method="get" class="row g-2 align-items-end">
            <div class="col-md-9">
                <label class="form-label fw-semibold" style="font-size:0.9rem;">Search by ID / Student ID / Email / Name</label>
                <input type="text" name="searchId" value="@ViewData["CurrentFilter"]" class="form-control" placeholder="e.g. 5  or  22103042  or  student@example.com  or  Shakkhor" style="border-radius:8px;" />
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary-custom flex-fill" style="border-radius:8px;">🔍 Search</button>
                @if (ViewData["CurrentFilter"] != null && !string.IsNullOrWhiteSpace(ViewData["CurrentFilter"]?.ToString()))
                {
                    <a asp-action="AllRequests" class="btn btn-outline-secondary flex-fill" style="border-radius:8px;">Clear</a>
                }
            </div>
        </form>
        @if (ViewData["CurrentFilter"] != null && !string.IsNullOrWhiteSpace(ViewData["CurrentFilter"]?.ToString()))
        {
            <div class="mt-2" style="font-size:0.85rem;color:#6c757d;">
                Showing results for: <strong>"@ViewData["CurrentFilter"]"</strong> — @Model.Count() record(s) found.
            </div>
        }
    </div>
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <div class="empty-icon">📭</div>
        <h5 class="fw-bold">No Requests Found</h5>
        <p>No student service requests have been submitted yet.</p>
    </div>
}
else
{
    <div class="table-modern">
        <table class="table mb-0">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Student</th>
                    <th>Student ID</th>
                    <th>Type</th>
                    <th>Description</th>
                    <th>Status</th>
                    <th>Submitted</th>
                    <th class="text-end">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold">@item.Id</td>
                        <td>
                            <div>@item.StudentName</div>
                            <small class="text-muted">@item.StudentEmail</small>
                        </td>
                        <td><span class="badge bg-light text-dark" style="border:1px solid #dee2e6;font-weight:600;">@item.StudentIdNumber</span></td>
                        <td>@item.RequestType</td>
                        <td>@(item.Description.Length > 35 ? item.Description.Substring(0, 35) + "..." : item.Description)</td>
                        <td>
                            @switch (item.Status)
                            {
                                case IUBAT_Student_Service.Models.RequestStatus.Pending:
                                    <span class="status-badge status-pending">⏳ Pending</span>
                                    break;
                                case IUBAT_Student_Service.Models.RequestStatus.Processing:
                                    <span class="status-badge status-processing">🔄 Processing</span>
                                    break;
                                case IUBAT_Student_Service.Models.RequestStatus.Completed:
                                    <span class="status-badge status-completed">✅ Completed</span>
                                    break;
                                case IUBAT_Student_Service.Models.RequestStatus.Rejected:
                                    <span class="status-badge status-rejected">❌ Rejected</span>
                                    break;
                            }
                        </td>
                        <td>@item.CreatedDate.ToString("dd MMM yyyy")</td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-primary" style="border-radius:6px;">Details</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@model IUBAT_Student_Service.Models.ViewModels.ServiceRequestDetailViewModel
@{
    ViewData["Title"] = "Request Details";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="detail-card">
            <div class="detail-header">
                <h4 class="mb-0 fw-bold">Request #@Model.Id</h4>
                @switch (Model.Status)
                {
                    case IUBAT_Student_Service.Models.RequestStatus.Pending:
                        <span class="status-badge status-pending" style="font-size:0.9rem;">⏳ Pending</span>
                        break;
                    case IUBAT_Student_Service.Models.RequestStatus.Processing:
                        <span class="status-badge status-processing" style="font-size:0.9rem;">🔄 Processing</span>
                        break;
                    case IUBAT_Student_Service.Models.RequestStatus.Completed:
                        <span class="status-badge status-completed" style="font-size:0.9rem;">✅ Completed</span>
                        break;
                    case IUBAT_Student_Service.Models.RequestStatus.Rejected:
                        <span class="status-badge status-rejected" style="font-size:0.9rem;">❌ Rejected</span>
                        break;
                }
            </div>
            <div class="detail-body">
                <div class="detail-row">
                    <span class="detail-label">Request Type</span>
                    <span class="detail-value fw-bold">@Model.RequestType</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Description</span>
                    <span class="detail-value">@Model.Description</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Submitted On</span>
                    <span class="detail-value">@Model.CreatedDate.ToString("dd MMMM yyyy, hh:mm tt")</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Last Updated</span>
                    <span class="detail-value">@Model.UpdatedDate.ToString("dd MMMM yyyy, hh:mm tt")</span>
                </div>
            </div>
        </div>
        <div class="mt-4 d-flex gap-2">
            <a asp-action="MyRequests" class="btn btn-outline-secondary" style="border-radius:8px;">← Back to My Requests</a>
            @if (Model.Status == IUBAT_Student_Service.Models.RequestStatus.Pending)
            {
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post" style="display:inline;"
                      onsubmit="return confirm('Are you sure you want to delete this request? This cannot be undone.');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger" style="border-radius:8px;">🗑️ Delete Request</button>
                </form>
            }
            else
            {
                <button type="button" class="btn btn-outline-danger" disabled title="Only pending requests can be deleted" style="border-radius:8px;">🗑️ Delete (only Pending)</button>
            }
        </div>
    </div>
</div>

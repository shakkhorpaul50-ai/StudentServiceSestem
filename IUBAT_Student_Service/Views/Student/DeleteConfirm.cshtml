@model IUBAT_Student_Service.Models.ViewModels.ServiceRequestDetailViewModel
@{
    ViewData["Title"] = "Delete Request";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="detail-card" style="border:1px solid #f5c2c7;">
            <div class="detail-header" style="background:#fff5f5;">
                <h4 class="mb-0 fw-bold text-danger">Confirm Delete — Request #@Model.Id</h4>
                <span class="status-badge status-pending">⏳ @Model.Status</span>
            </div>
            <div class="detail-body">
                <div class="alert alert-warning" style="border-radius:8px;">
                    ⚠️ Are you sure you want to delete this request? This action <strong>cannot be undone</strong>.
                </div>
                <div class="detail-row">
                    <span class="detail-label">Request Type</span>
                    <span class="detail-value fw-bold">@Model.RequestType</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Description</span>
                    <span class="detail-value">@Model.Description</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Submitted On</span>
                    <span class="detail-value">@Model.CreatedDate.ToString("dd MMMM yyyy, hh:mm tt")</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Status</span>
                    <span class="detail-value">@Model.Status</span>
                </div>
                @if (Model.Status != IUBAT_Student_Service.Models.RequestStatus.Pending)
                {
                    <div class="alert alert-danger mt-3" style="border-radius:8px;">
                        Only <strong>Pending</strong> requests can be deleted. This request is <strong>@Model.Status</strong> and cannot be deleted.
                    </div>
                }
            </div>
        </div>
        <div class="mt-4 d-flex gap-2">
            <a asp-action="MyRequests" class="btn btn-outline-secondary" style="border-radius:8px;">← Cancel</a>
            @if (Model.Status == IUBAT_Student_Service.Models.RequestStatus.Pending)
            {
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post" style="display:inline;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger" style="border-radius:8px;">Yes, Delete Permanently</button>
                </form>
            }
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-primary" style="border-radius:8px;">View Details</a>
        </div>
    </div>
</div>

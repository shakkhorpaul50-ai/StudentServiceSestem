                    <a href="https://www.youtube.com/channel/UCj0l541NI9bgnufJu-EHfcw" target="_blank" style="font-size:12.5px; color:var(--sust-navy);"><i class="fab fa-youtube" style="color:#FF0000; margin-right:6px;"></i> YouTube — IUBAT</a>
                    <a href="https://x.com/IUBAT_BD" target="_blank" style="font-size:12.5px; color:var(--sust-navy);"><i class="fab fa-x-twitter" style="margin-right:6px;"></i> x.com/IUBAT_BD</a>
                </div>
            </div>
        </div>
    </div>
</div>


                <div class="d-flex flex-column gap-1">
                    <a href="https://iubat.edu" target="_blank" style="font-size:12.5px; color:var(--sust-navy);"><i class="fas fa-globe" style="color:var(--sust-red); margin-right:6px;"></i> iubat.edu</a>
